{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shark Books Community",
  "version": "0.0.1",
  "identifier": "uk.co.mtdshark.sharkbookscommunity",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Shark Books Community \u2014 SBC-1D Windows Shell",
        "width": 760,
        "height": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self'"
      },
      "capabilities": [
        "windows-main"
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
